<Window
    x:Class="WindowsUtil.Base.CustomChangeWindowSize2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WindowsUtil.Base"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CustomChangeWindowSize2"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Path
            x:Name="ResizeNW"
            Margin="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            MouseEnter="DisplayResizeCursor"
            MouseLeave="ResetCursor"
            PreviewMouseLeftButtonDown="Resize"
            Stroke="Green"
            StrokeThickness="4">
            <Path.Data>
                <PathGeometry>
                    <PathGeometry.Figures>
                        <PathFigureCollection>
                            <PathFigure StartPoint="0,10">
                                <PathFigure.Segments>
                                    <PathSegmentCollection>
                                        <QuadraticBezierSegment Point1="0,0" Point2="10,0" />
                                    </PathSegmentCollection>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathFigureCollection>
                    </PathGeometry.Figures>
                </PathGeometry>
            </Path.Data>
        </Path>
        <Path
            x:Name="ResizeNE"
            Margin="0,0,-2,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            MouseEnter="DisplayResizeCursor"
            MouseLeave="ResetCursor"
            PreviewMouseLeftButtonDown="Resize"
            Stroke="Green"
            StrokeThickness="4">
            <Path.Data>
                <PathGeometry>
                    <PathGeometry.Figures>
                        <PathFigureCollection>
                            <PathFigure StartPoint="0,0">
                                <PathFigure.Segments>
                                    <PathSegmentCollection>
                                        <QuadraticBezierSegment Point1="10,0" Point2="10,10" />
                                    </PathSegmentCollection>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathFigureCollection>
                    </PathGeometry.Figures>
                </PathGeometry>
            </Path.Data>
        </Path>
        <Path
            x:Name="ResizeSE"
            Margin="0,0,-2,-2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MouseEnter="DisplayResizeCursor"
            MouseLeave="ResetCursor"
            PreviewMouseLeftButtonDown="Resize"
            Stroke="Green"
            StrokeThickness="4">
            <Path.Data>
                <PathGeometry>
                    <PathGeometry.Figures>
                        <PathFigureCollection>
                            <PathFigure StartPoint="10,0">
                                <PathFigure.Segments>
                                    <PathSegmentCollection>
                                        <QuadraticBezierSegment Point1="10,10" Point2="0,10" />
                                    </PathSegmentCollection>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathFigureCollection>
                    </PathGeometry.Figures>
                </PathGeometry>
            </Path.Data>
        </Path>
        <Path
            x:Name="ResizeSW"
            Margin="0,0,0,-2"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            MouseEnter="DisplayResizeCursor"
            MouseLeave="ResetCursor"
            PreviewMouseLeftButtonDown="Resize"
            Stroke="Green"
            StrokeThickness="4">
            <Path.Data>
                <PathGeometry>
                    <PathGeometry.Figures>
                        <PathFigureCollection>
                            <PathFigure StartPoint="0,0">
                                <PathFigure.Segments>
                                    <PathSegmentCollection>
                                        <QuadraticBezierSegment Point1="0,10" Point2="10,10" />
                                    </PathSegmentCollection>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathFigureCollection>
                    </PathGeometry.Figures>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>
</Window>
